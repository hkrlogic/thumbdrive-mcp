{
  "name": "thumbdrive-mcp",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "A virtual USB drive for agents: a self-hosted, read-only MCP file server with checksums and version history.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hkrlogic/thumbdrive-mcp.git"
  },
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning --import tsx src/index.ts",
    "dev": "node --watch --disable-warning=ExperimentalWarning --import tsx src/index.ts",
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint",
    "admin": "node --disable-warning=ExperimentalWarning --import tsx scripts/admin.ts",
    "smoke": "node --disable-warning=ExperimentalWarning --import tsx scripts/smoke.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "@modelcontextprotocol/node": "^2.1.1",
    "@modelcontextprotocol/server": "^2.3.1",
    "hono": "^4.13.13",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@modelcontextprotocol/client": "^2.3.1",
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
